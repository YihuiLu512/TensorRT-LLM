#!/bin/bash
# SPDX-FileCopyrightText: Copyright (c) 2026 NVIDIA CORPORATION & AFFILIATES. All rights reserved.
# SPDX-License-Identifier: Apache-2.0
#
# DRAFT - NOT SUBMITTABLE. Needs explicit user approval (plan RESOURCES 9.1 tokenizer note): this
# job reads the model library, which no-model jobs must never see. `capjobs.submit prep-tokenizer`
# only prints the would-be command (--dry-run); after approval a dedicated entry is written.
#
# Runs on the node host: no container, no Python, no GPU. Copies ONLY whitelisted non-weight files
# from the top level of a model dir into <dest>, refuses weight files and symlinks in the result,
# writes SHA256SUMS.txt and PROVENANCE.txt, makes the copy read-only.
#   prep_tokenizer.sbatch.draft <model dir> <dest dir (must not exist)>
set -euo pipefail

[[ $# -eq 2 ]] || { echo "usage: prep_tokenizer.sbatch.draft <model dir> <dest dir>" >&2; exit 2; }
SRC=$1
DEST=$2
[[ $SRC == /* && $DEST == /* ]] || { echo "paths must be absolute" >&2; exit 2; }
[[ -d $SRC ]] || { echo "model dir $SRC is not a directory" >&2; exit 3; }
[[ ! -e $DEST && ! -e $DEST.partial ]] || { echo "$DEST or $DEST.partial exists" >&2; exit 3; }

WEIGHT_RE='\.(safetensors|bin|pt|pth|gguf|engine)$'
# Exact names, plus the patterns *.tiktoken and *.jinja (chat templates).
WHITELIST=(tokenizer.json tokenizer_config.json special_tokens_map.json config.json
           generation_config.json vocab.json vocab.txt merges.txt added_tokens.json
           tokenizer.model chat_template.json chat_template.jinja)

allowed() {
    local n=$1 w
    [[ $n =~ $WEIGHT_RE ]] && return 1
    for w in "${WHITELIST[@]}"; do [[ $n == "$w" ]] && return 0; done
    [[ $n == *.tiktoken || $n == *.jinja ]] && return 0
    return 1
}

mkdir -p -- "$(dirname -- "$DEST")"
mkdir -- "$DEST.partial"
copied=()
skipped=()
while IFS= read -r -d '' f; do
    n=$(basename -- "$f")
    if allowed "$n"; then
        cp -L -- "$f" "$DEST.partial/$n"
        copied+=("$n")
    else
        skipped+=("$n")
    fi
done < <(command find "$SRC" -mindepth 1 -maxdepth 1 \( -type f -o -type l \) -print0 | sort -z)

# Checks on the result (count first: an empty copy is a failure, not a pass).
[[ ${#copied[@]} -gt 0 ]] || { echo "FAIL: no whitelisted file in $SRC" >&2; exit 4; }
have_vocab=0
for n in "${copied[@]}"; do
    case $n in tokenizer.json|tokenizer.model|vocab.json|vocab.txt|*.tiktoken) have_vocab=1 ;; esac
done
[[ $have_vocab == 1 ]] || { echo "FAIL: no tokenizer vocabulary file copied" >&2; exit 4; }
bad=$(command find "$DEST.partial" -mindepth 1 \( -type l -o ! -type f \) -print | head -n 5)
[[ -z $bad ]] || { echo "FAIL: non-regular entries in the copy: $bad" >&2; exit 4; }
w=$(command find "$DEST.partial" -type f -print | LC_ALL=C command grep -E "$WEIGHT_RE" | head -n 5 || true)
[[ -z $w ]] || { echo "FAIL: weight files in the copy: $w" >&2; exit 4; }

(cd -- "$DEST.partial" && LC_ALL=C sha256sum -- "${copied[@]}") > "$DEST.partial/SHA256SUMS.txt"
{
    printf 'source\t%s\n' "$SRC"
    printf 'copied_at\t%s\n' "$(date -u +%Y-%m-%dT%H:%M:%S.%3NZ)"
    printf 'host\t%s\n' "$(hostname)"
    printf 'job_id\t%s\n' "${SLURM_JOB_ID:-none}"
    printf 'copied\t%s\n' "${copied[*]}"
    printf 'skipped\t%s\n' "${skipped[*]}"
} > "$DEST.partial/PROVENANCE.txt"
chmod -R a-w -- "$DEST.partial"
mv -T -- "$DEST.partial" "$DEST"
echo "OK: ${#copied[@]} files -> $DEST"
