# E12-L2a PATH shim (copy of WT-21's reqlog/bin/python, E12_ prefix): perf sanity starts its client
# as `python -m tensorrt_llm.serve.scripts.benchmark_serving ...`; with E12_REQLOG_DIR set that one
# command runs through ../reqlog_l2a.py (W1-W6). Every other `python` call is passed through to
# the next python on PATH (or /usr/bin/python3).
self_dir=$(cd "$(dirname "${BASH_SOURCE[0]}")" && pwd)
real=""
IFS=: read -r -a parts <<< "$PATH"
for d in "${parts[@]}"; do
    [[ -z $d ]] && continue
    [[ $(cd "$d" 2>/dev/null && pwd) == "$self_dir" ]] && continue
    if [[ -x $d/python && ! -d $d/python ]]; then real=$d/python; break; fi
done
[[ -n $real ]] || real=/usr/bin/python3
if [[ ${1:-} == -m && ${2:-} == tensorrt_llm.serve.scripts.benchmark_serving && -n ${E12_REQLOG_DIR:-} ]]; then
    shift 2
    exec "$real" "$self_dir/../reqlog_l2a.py" "$@"
fi
exec "$real" "$@"
