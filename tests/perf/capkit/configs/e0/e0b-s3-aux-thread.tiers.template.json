{
 "schema": "capkit.tiers_template/1",
 "experiment": "E0",
 "name": "e0b-s3-aux-thread",
 "arrival": {
  "dist": "fixed",
  "seed": "TBD:arrival_seed"
 },
 "axis": {
  "name": "M",
  "load_key": "nominal_msgs_per_s",
  "unit": "msg/s",
  "order": "asc"
 },
 "request_timeout_ns": "TBD:request_timeout_ns",
 "default_gate": {
  "mode": "enforce",
  "rule": "abs_max",
  "readings": [
   {
    "name": "grpc_in_flight",
    "terms": [
     {
      "role": "beat",
      "slot": "backlog.yielded",
      "sign": 1,
      "agg": "sum"
     },
     {
      "role": "drain",
      "slot": "backlog.read",
      "sign": -1,
      "agg": "sum"
     }
    ],
    "abs_max": 0
   },
   {
    "name": "beat_pending",
    "terms": [
     {
      "role": "beat",
      "slot": "backlog.pending_msgs",
      "sign": 1,
      "agg": "sum"
     }
    ],
    "abs_max": 0
   },
   {
    "name": "drain_active",
    "terms": [
     {
      "role": "drain",
      "slot": "backlog.active_streams",
      "sign": 1,
      "agg": "sum"
     }
    ],
    "abs_max": 0
   },
   {
    "name": "drain_inflight",
    "terms": [
     {
      "role": "drain",
      "slot": "backlog.inflight",
      "sign": 1,
      "agg": "sum"
     }
    ],
    "abs_max": 0
   },
   {
    "name": "relay1_queue",
    "terms": [
     {
      "role": "relay1",
      "slot": "backlog.queue_msgs",
      "sign": 1,
      "agg": "sum"
     }
    ],
    "abs_max": 0
   }
  ],
  "poll_ns": "TBD:gate_poll_ns",
  "settle_polls": "TBD:gate_settle_polls",
  "deadline_guard_ns": "TBD:gate_deadline_guard_ns",
  "max_snapshot_age_ns": "TBD:gate_max_snapshot_age_ns"
 },
 "launch_inject": [
  {
   "role": "relay1",
   "site": "relay.msg",
   "mode": "busy",
   "delta_ns": "TBD:delta_ns",
   "where": "aux_thread"
  }
 ],
 "common": {
  "max_tokens": "TBD:n_tokens",
  "tokens_per_msg": 1,
  "stream_interval": 1,
  "beat_ns": "TBD:beat_ns",
  "prompt_set": "short"
 },
 "tiers": [
  {
   "label": "warmup",
   "kind": "warmup",
   "ramp_ns": 0,
   "window_ns": "TBD:warmup_ns",
   "tail_ns": 0,
   "streams_c": "TBD:c_warmup",
   "rate_rps": "from_streams_c"
  },
  {
   "label": "drain-01",
   "kind": "drain",
   "window_ns": "TBD:drain_max_wait_ns"
  },
  {
   "label": "up-sub",
   "kind": "up",
   "ramp_ns": "TBD:ramp_ns",
   "window_ns": "TBD:window_ns",
   "tail_ns": "TBD:tail_ns",
   "baseline": true,
   "streams_c": "TBD:c_sub",
   "rate_rps": "from_streams_c"
  },
  {
   "label": "drain-02",
   "kind": "drain",
   "window_ns": "TBD:drain_max_wait_ns"
  },
  {
   "label": "up-near",
   "kind": "up",
   "ramp_ns": "TBD:ramp_ns",
   "window_ns": "TBD:window_ns",
   "tail_ns": "TBD:tail_ns",
   "baseline": false,
   "streams_c": "TBD:c_near",
   "rate_rps": "from_streams_c"
  },
  {
   "label": "drain-03",
   "kind": "drain",
   "window_ns": "TBD:drain_max_wait_ns"
  },
  {
   "label": "up-over",
   "kind": "up",
   "ramp_ns": "TBD:ramp_ns",
   "window_ns": "TBD:window_ns",
   "tail_ns": "TBD:tail_ns",
   "baseline": false,
   "streams_c": "TBD:c_over",
   "rate_rps": "from_streams_c"
  },
  {
   "label": "drain-04",
   "kind": "drain",
   "window_ns": "TBD:drain_max_wait_ns"
  },
  {
   "label": "down-near",
   "kind": "down",
   "ramp_ns": "TBD:ramp_ns",
   "window_ns": "TBD:window_ns",
   "tail_ns": "TBD:tail_ns",
   "baseline": false,
   "streams_c": "TBD:c_near",
   "rate_rps": "from_streams_c"
  },
  {
   "label": "drain-05",
   "kind": "drain",
   "window_ns": "TBD:drain_max_wait_ns"
  },
  {
   "label": "down-sub",
   "kind": "down",
   "ramp_ns": "TBD:ramp_ns",
   "window_ns": "TBD:window_ns",
   "tail_ns": "TBD:tail_ns",
   "baseline": false,
   "streams_c": "TBD:c_sub",
   "rate_rps": "from_streams_c"
  },
  {
   "label": "drain-06",
   "kind": "drain",
   "window_ns": "TBD:drain_max_wait_ns"
  }
 ],
 "note": "sub-saturation / near / over the plateau (design E0 'load' (b)); busy-wait on an aux Python thread of the relay process"
}
