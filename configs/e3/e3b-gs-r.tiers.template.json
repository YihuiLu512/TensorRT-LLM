{
 "schema": "capkit.tiers_template/1",
 "experiment": "E3",
 "name": "e3b-gs-r",
 "arrival": {
  "dist": "fixed",
  "seed": "TBD:arrival_seed"
 },
 "axis": {
  "name": "R",
  "load_key": "rate_rps",
  "unit": "req/s",
  "order": "asc"
 },
 "request_timeout_ns": "TBD:request_timeout_ns",
 "default_gate": {
  "mode": "enforce",
  "rule": "abs_max",
  "readings": [
   {
    "name": "grpc_in_flight",
    "terms": [
     {
      "role": "spb",
      "slot": "backlog.yielded",
      "sign": 1,
      "agg": "sum"
     },
     {
      "role": "reader",
      "slot": "backlog.read",
      "sign": -1,
      "agg": "sum"
     }
    ],
    "abs_max": 0
   },
   {
    "name": "spb_pending",
    "terms": [
     {
      "role": "spb",
      "slot": "backlog.pending_msgs",
      "sign": 1,
      "agg": "sum"
     }
    ],
    "abs_max": 0
   },
   {
    "name": "spb_active",
    "terms": [
     {
      "role": "spb",
      "slot": "backlog.active_streams",
      "sign": 1,
      "agg": "sum"
     }
    ],
    "abs_max": 0
   },
   {
    "name": "reader_active",
    "terms": [
     {
      "role": "reader",
      "slot": "backlog.active_streams",
      "sign": 1,
      "agg": "sum"
     }
    ],
    "abs_max": 0
   },
   {
    "name": "reader_inflight",
    "terms": [
     {
      "role": "reader",
      "slot": "backlog.inflight",
      "sign": 1,
      "agg": "sum"
     }
    ],
    "abs_max": 0
   }
  ],
  "poll_ns": "TBD:gate_poll_ns",
  "settle_polls": "TBD:gate_settle_polls",
  "deadline_guard_ns": "TBD:gate_deadline_guard_ns",
  "max_snapshot_age_ns": "TBD:gate_max_snapshot_age_ns"
 },
 "launch_inject": [],
 "common": {
  "max_tokens": 1,
  "beat_ns": "TBD:beat_ns",
  "tokens_per_msg": 1,
  "stream_interval": 1,
  "prompt_set": "short"
 },
 "tiers": [
  {
   "label": "warmup",
   "kind": "warmup",
   "ramp_ns": 0,
   "window_ns": "TBD:warmup_ns",
