{
 "schema": "capkit.tiers_template/1",
 "experiment": "E4",
 "name": "e4b-md",
 "arrival": {
  "dist": "fixed",
  "seed": "TBD:arrival_seed"
 },
 "axis": {
  "name": "M",
  "load_key": "nominal_msgs_per_s",
  "unit": "msg/s",
  "order": "asc"
 },
 "request_timeout_ns": "TBD:request_timeout_ns",
 "default_gate": {
  "mode": "enforce",
  "rule": "abs_max",
  "readings": [
   {
    "name": "loadgen_inflight",
    "terms": [
     {
      "role": "capload",
      "slot": "backlog.inflight",
      "sign": 1,
      "agg": "sum"
     }
    ],
    "abs_max": 0
   },
   {
    "name": "spb_pending",
    "terms": [
     {
      "role": "spb",
      "slot": "backlog.pending_msgs",
      "sign": 1,
      "agg": "sum"
     }
    ],
    "abs_max": 0
   },
   {
    "name": "spb_active",
    "terms": [
     {
      "role": "spb",
      "slot": "backlog.active_streams",
      "sign": 1,
      "agg": "sum"
     }
    ],
    "abs_max": 0
   }
  ],
  "poll_ns": "TBD:gate_poll_ns",
  "settle_polls": "TBD:gate_settle_polls",
  "deadline_guard_ns": "TBD:gate_deadline_guard_ns",
  "max_snapshot_age_ns": "TBD:gate_max_snapshot_age_ns"
 },
 "launch_inject": [],
 "common": {
  "max_tokens": "TBD:n_tokens",
  "streams_c": "TBD:c_fixed",
  "tokens_per_msg": 1,
  "stream_interval": 1,
  "prompt_set": "tid128"
 },
 "tiers": [
  {
   "label": "warmup",
   "kind": "warmup",
   "ramp_ns": 0,
   "window_ns": "TBD:warmup_ns",
   "tail_ns": 0,
   "beat_ns": "TBD:beat_ns_warmup",
   "rate_rps": "from_streams_c"
  },
  {
   "label": "drain-01",
   "kind": "drain",
   "window_ns": "TBD:drain_max_wait_ns"
  },
  {
   "label": "up-01",
   "kind": "up",
   "ramp_ns": "TBD:ramp_ns",
   "window_ns": "TBD:window_ns",
   "tail_ns": "TBD:tail_ns",
   "baseline": true,
   "beat_ns": "TBD:beat_ns_0",
   "rate_rps": "from_streams_c"
  },
  {
   "label": "drain-02",
   "kind": "drain",
   "window_ns": "TBD:drain_max_wait_ns"
  },
  {
   "label": "up-02",
   "kind": "up",
   "ramp_ns": "TBD:ramp_ns",
   "window_ns": "TBD:window_ns",
   "tail_ns": "TBD:tail_ns",
   "baseline": false,
   "beat_ns": "TBD:beat_ns_1",
   "rate_rps": "from_streams_c"
  },
  {
   "label": "drain-03",
