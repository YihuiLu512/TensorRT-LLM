{
 "schema": "capkit.tiers_template/1",
 "experiment": "E4",
 "name": "e4b-nb-r",
 "arrival": {
  "dist": "fixed",
  "seed": "TBD:arrival_seed"
 },
 "axis": {
  "name": "R",
  "load_key": "rate_rps",
  "unit": "req/s",
  "order": "asc"
 },
 "request_timeout_ns": "TBD:request_timeout_ns",
 "default_gate": {
  "mode": "enforce",
  "rule": "abs_max",
  "readings": [
   {
    "name": "loadgen_inflight",
    "terms": [
     {
      "role": "capload",
      "slot": "backlog.inflight",
      "sign": 1,
      "agg": "sum"
     }
    ],
    "abs_max": 0
   },
   {
    "name": "spb_pending",
    "terms": [
     {
      "role": "spb",
      "slot": "backlog.pending_msgs",
      "sign": 1,
      "agg": "sum"
     }
    ],
    "abs_max": 0
   },
   {
    "name": "spb_active",
    "terms": [
     {
      "role": "spb",
      "slot": "backlog.active_streams",
      "sign": 1,
      "agg": "sum"
     }
    ],
    "abs_max": 0
   }
  ],
  "poll_ns": "TBD:gate_poll_ns",
  "settle_polls": "TBD:gate_settle_polls",
  "deadline_guard_ns": "TBD:gate_deadline_guard_ns",
  "max_snapshot_age_ns": "TBD:gate_max_snapshot_age_ns"
 },
 "launch_inject": [],
 "common": {
  "max_tokens": 1,
  "beat_ns": "TBD:beat_ns",
  "tokens_per_msg": 1,
  "stream_interval": 1,
  "prompt_set": "tid128"
 },
 "tiers": [
  {
   "label": "warmup",
   "kind": "warmup",
   "ramp_ns": 0,
   "window_ns": "TBD:warmup_ns",
   "tail_ns": 0,
   "rate_rps": "TBD:rate_warmup"
  },
  {
   "label": "drain-01",
   "kind": "drain",
   "window_ns": "TBD:drain_max_wait_ns"
  },
  {
   "label": "up-01",
   "kind": "up",
   "ramp_ns": "TBD:ramp_ns",
   "window_ns": "TBD:window_ns",
   "tail_ns": "TBD:tail_ns",
   "baseline": true,
   "rate_rps": "TBD:rate_0"
  },
  {
   "label": "drain-02",
   "kind": "drain",
   "window_ns": "TBD:drain_max_wait_ns"
  }
 ],
 "note": "R axis: shortest output (max_tokens 1), rate_0 < rate_1 < ... (doubling); register once per beat period (at least two values, design 2.1 'R axis delta'); TEMPLATE: every TBD value is filled at registration from the E1 / E2a results (fast track, exploratory)"
}
